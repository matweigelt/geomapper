<deployment-project plugin="plugin.toolbox" plugin-version="1.0">
  <configuration file="geoMap.prj" location="." name="geoMap" target="target.toolbox" target-name="Package Toolbox">
    <param.appname>geoMap</param.appname>
    <param.authnamewatermark>Matthias Weigelt</param.authnamewatermark>
    <param.email>matthiasweigelt@googlemail.com</param.email>
    <param.company />
    <param.summary>Cartographic visualisation in base MATLAB for GRACE-like satellite gravimetry.</param.summary>
    <param.description>Publication-quality maps for equivalent water height, mascon solutions, trend maps, along-track products and station time series.

Base MATLAB only: no Mapping, Image Processing or Statistics Toolbox. Sixteen projections forward and inverse, each with a queryable domain. Pages export at an exact physical size in centimetres.

The model is a SPHERE (authalic radius 6371.0072 km), good to about 0.3%. This is a visualisation tool, not a survey tool.</param.description>
    <param.screenshot />
    <param.version>2.0.489-alpha.1</param.version>
    <param.output>${PROJECT_ROOT}/geoMap.mltbx</param.output>
    <param.products.name />
    <param.products.id />
    <param.products.version />
    <param.platforms />
    <param.guid />
    <param.exclude.filters>% Everything that verifies the toolbox, and nothing the toolbox needs
% to run. A user installing this gets the code, its data and its
% manual; the harness, the mirror and the working records stay in the
% repository where they are useful.
%
% NOTE the version above is 2.0.489-alpha.1 and Contents.m is the
% authority for it. tools/geoMapAudit.m checks this file against
% Contents.m; it is not maintained independently.
tests/
tools/
records/
mirror/
docbuild/
docs/BEST_PRACTICE_v4.md
.github/
HANDOVER.md
RECORDS.md
WORKFLOW.md
CONTRIBUTING.md
MANIFEST.txt
buildfile.m
geoMapSetup.m
**/.git*</param.exclude.filters>
    <param.exclude.pcodedmfiles>true</param.exclude.pcodedmfiles>
    <param.examples />
    <param.demosxml />
    <param.apps />
    <param.registered.apps />
    <param.docs>${PROJECT_ROOT}/docs/html/helptoc.xml</param.docs>
    <param.getting.started.guide>${PROJECT_ROOT}/GettingStarted.m</param.getting.started.guide>
    <param.matlabpath.excludes />
    <param.javaclasspath.excludes />
    <param.exported.on.package>false</param.exported.on.package>
    <param.required.addons />
    <param.matlab.project.id />
    <param.matlab.project.name />
    <param.release.start>R2026a</param.release.start>
    <param.release.end>latest</param.release.end>
    <param.release.current.only>false</param.release.current.only>
    <param.compatiblity.windows>true</param.compatiblity.windows>
    <param.compatiblity.macos>true</param.compatiblity.macos>
    <param.compatiblity.linux>true</param.compatiblity.linux>
    <param.installation.map />
    <param.additional.sw.names />
    <param.additional.sw.licenses />
    <param.additional.sw.win.url />
    <param.additional.sw.mac.url />
    <param.additional.sw.linux.url />
    <fileset.rootdir>
      <file>${PROJECT_ROOT}</file>
    </fileset.rootdir>
    <fileset.rootfiles>
      <file>${PROJECT_ROOT}/+geo</file>
      <file>${PROJECT_ROOT}/CHANGELOG.md</file>
      <file>${PROJECT_ROOT}/CITATION.cff</file>
      <file>${PROJECT_ROOT}/Contents.m</file>
      <file>${PROJECT_ROOT}/GettingStarted.m</file>
      <file>${PROJECT_ROOT}/LICENSE</file>
      <file>${PROJECT_ROOT}/README.md</file>
      <file>${PROJECT_ROOT}/data</file>
      <file>${PROJECT_ROOT}/docs/html</file>
      <file>${PROJECT_ROOT}/info.xml</file>
    </fileset.rootfiles>
    <fileset.depfun.included />
    <fileset.depfun.excluded />
    <fileset.package />
    <build-deliverables>
      <file location="${PROJECT_ROOT}" name="geoMap.mltbx" optional="false">${PROJECT_ROOT}/geoMap.mltbx</file>
    </build-deliverables>
  </configuration>
</deployment-project>
